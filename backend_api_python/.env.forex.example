# ==============================================================================
# QuantDinger + Exness MT5 Forex Trading Configuration
# ==============================================================================
# ไฟล์นี้เก็บการตั้งค่าระบบและบัญชีเทรด (ถูกละเว้นจาก Git โดย .gitignore ปลอดภัย 100%)

# ==============================================================================
# 1. EXNESS / METATRADER 5 ACCOUNT CREDENTIALS (โปรดใส่ข้อมูลบัญชีของท่านที่นี่)
# ==============================================================================
# เลขที่บัญชี MT5 ของ Exness (เช่น 123456789)
MT5_ACCOUNT=

# รหัสผ่านเทรด (Trading Password) ของบัญชี MT5
MT5_PASSWORD=

# ชื่อ Server ของ Exness (เช่น Exness-MT5Trial หรือ Exness-MT5Trial6 สำหรับ Demo)
MT5_SERVER=Exness-MT5Trial

# ตำแหน่งโปรแกรม Exness MT5 บนเครื่อง Windows (ระบบตรวจพบและระบุไว้ให้อัตโนมัติ)
MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe


# ==============================================================================
# 2. FOREX & SMC SNIPER STRATEGY PARAMETERS
# ==============================================================================
# สัญลักษณ์คู่เงิน (Exness Micro ใช้ลงท้ายด้วย m)
MT5_SYMBOL=EURUSDm

# ขนาด Lot ต่อไม้ (พอร์ต $45-$50 ใช้ 0.01 lot เท่านั้น)
MT5_DEFAULT_VOLUME=0.01

# Magic Number ประจำตัวบอทเพื่อแยกแยะออเดอร์
MT5_MAGIC_NUMBER=202609

# ระยะตัดขาดทุนและทำกำไรเริ่มต้น (เป็น pips)
DEFAULT_SL_PIPS=12
DEFAULT_TP_PIPS=60


# ==============================================================================
# 3. SAFETY & CIRCUIT BREAKER (ระบบความปลอดภัยระดับพอร์ต)
# ==============================================================================
# ระบบป้องกันเงินจริง: ต้องเป็น true เท่านั้นจึงจะยอมยิงบัญชี Real (ค่าเริ่มต้นเป็น false เพื่อความปลอดภัย)
FOREX_ALLOW_REAL=false

# จำนวนไม้แพ้ติดต่อกันสูงสุด ก่อนระบบจะหยุดเทรดอัตโนมัติ 48 ชั่วโมง
MAX_CONSECUTIVE_LOSSES=3

# ขีดจำกัดเงินทุนขั้นต่ำ (หาก Balance ต่ำกว่านี้ ระบบจะ Freeze หยุดเปิดไม้ทันที)
CAPITAL_FLOOR=35.0

# กฎการเติมไม้ (Pyramiding): เปิดไม้ 2 ได้เฉพาะเมื่อไม้แรกเลื่อน SL มา Breakeven แล้วเท่านั้น
ENFORCE_ZERO_RISK_PYRAMIDING=true


# ==============================================================================
# 4. QUANTDINGER CORE & DATABASE CONFIGURATION
# ==============================================================================
SECRET_KEY=ba95c7b93ff8aef8fe2c366990f28c52f3eecad0d50afd9feb33bc627f160aa8
CREDENTIAL_ENCRYPTION_KEY=7ee91af48509f6ec8a0233abc12bdf0463a46aad40a522c244567ad323ebe76b

ADMIN_USER=quantdinger
ADMIN_PASSWORD=quantdinger123

# การเชื่อมต่อฐานข้อมูล PostgreSQL
DATABASE_URL=postgresql://quantdinger:quantdinger123@localhost:5432/quantdinger
DB_TYPE=postgresql

# การเชื่อมต่อ Redis (Task Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# ปิดฟังก์ชันที่ไม่ได้ใช้งานในเฟสนี้เพื่อประหยัดทรัพยากร
CACHE_ENABLED=false
SKIP_STARTUP_HOOKS=1
